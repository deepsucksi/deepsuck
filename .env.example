# DeepSuck 可选大模型配置
# 复制为 .env 后填写；.env 已在 .gitignore 中，切勿提交真实 Key。
# 不填写任何 Key 时，项目照常以“规则引擎”运行。

# 阿里云百炼 / DashScope API Key（https://bailian.console.aliyun.com/ 获取）
DASHSCOPE_API_KEY=

# OpenAI 兼容接口（默认百炼兼容模式；可换成其他国产大模型的兼容地址）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
# 可选：qwen3.8-flash（默认）、qwen3.8-max；3.8 系列其他型号见百炼模型列表 https://help.aliyun.com/zh/model-studio/models
# 若使用非百炼服务，可用 LLM_API_KEY 代替 DASHSCOPE_API_KEY（优先级更高）
# LLM_API_KEY=
# LLM_TEMPERATURE=0.9
# 思考模式：代理固定显式发 enable_thinking，默认 false（qwen3.8-flash 默认开思考，开了回复慢且多计思考 token）；设 1 才开
# LLM_ENABLE_THINKING=0

# 本地服务（默认只监听本机；部署到服务器时请放在 Nginx/HTTPS 之后再改为 0.0.0.0）
HOST=127.0.0.1
PORT=8787
# 每个 IP 每分钟最多调用 /api/chat 次数（防止 Key 被滥用产生费用）
RATE_LIMIT_PER_MIN=20

# ---- 公开部署时的费用护栏（完整说明见 docs/DEPLOY.md 与 deploy/.env.example）----
# CHAT_DAILY_BUDGET_CNY=2      # 每日预算（元），0 = 不限（仅本地）
# RATE_LIMIT_PER_DAY=300       # 每 IP 每天
# GLOBAL_RATE_PER_MIN=60       # 全站每分钟
# CHAT_MAX_TURNS=40            # 每局最多轮数
# ALLOWED_ORIGINS=https://deepsuck.si,https://www.deepsuck.si
# TRUST_PROXY=1                # 在反向代理之后时，用 X-Forwarded-For 识别客户端 IP
# DATA_DIR=./data              # 预算账本目录
