    "digitJoin": {
      "comment": "数字分组拼接：数字之间夹空格 / 横杠 / 换行 / 标点（，、。.·/ 等，每处 1–3 个）时，按“拼起来是合法手机号或银行卡”才删除分隔符；单组本身已是完整号码、或紧跟金额单位的组不参与拼接。",
      "separators": " \t\r\n -_·.,，、。/|~～—–",
      "maxSep": 3,
      "maxGroup": 8,
      "unitAfter": "^\\s*(?:元|块|万|千|百|U(?![A-Za-z])|%|％|岁|年|月|日|号|点|分钟|小时|天|次|单|个)"
    },
    "walletJoin": {
      "comment": "钱包地址分段拼接：0x 开头的十六进制分段合计正好 40 位、T 开头的 Base58 分段合计正好 34 位才拼接（每段至少 3 个字符）。",
      "minChunk": 3
    }
  },
  "stitch": {
    "comment": "跨回合拼接（语音回合被切断：卡号念到一半停顿被切成两段）。同一说话方相邻 window 个回合：上一回合末尾的数字片段 + 下一回合开头的数字片段（只隔语气词/标点）拼接后再校验；任一片段本身已被识别为完整情报则不拼。置信度：银行卡 = 0.3 + Luhn 0.3 + BIN 命中 0.2（长度吻合再 +0.1）+ 银联 62 开头 0.1 + 上下文（卡号/账户…）0.2；手机号 = 0.6 + 上下文（电话/手机…）0.3。低于 minConfidence 不输出。 blockBefore / blockAfter：片段前后紧挨“工号、订单号、验证码”等词时不参与拼接（这些数字本来就不是卡号 / 手机号）。",
    "window": 3,
    "minConfidence": 0.5,
    "headFiller": "^(?:[\\s，,。.、…：:~～-]|呃|嗯|啊|哦|噢|然后是|然后|接着是|接着|后面是|后面|后边|还有|再就是|再|是|那个|就是|最后是|最后)*",
    "tailFiller": "(?:[\\s，,。.、…~～！!？?-]|呃|嗯|啊|哦|噢|那个|就是|然后)*$",
    "bankContext": "卡号|银行卡|账户|账号|卡|转到|转账|汇款|打到|银行|收款",
    "phoneContext": "电话|手机|号码|打我|联系|拨|来电|专线",
    "blockBefore": "(?:房间|工号|订单|单号|编号|尾号|会议号|验证码|校验码|密码|车牌|邀请码|门牌)[^0-9]{0,4}$",
    "blockAfter": "^[^0-9]{0,6}?(?:工号|订单|单号|编号|尾号|会议号|验证码|校验码|密码|车牌|邀请码|门牌)"
  }
