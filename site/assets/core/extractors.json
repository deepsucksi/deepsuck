  "patterns": {
    "urlFull": {
      "source": "(?:https?:\\/\\/|www\\.)[^\\s，。！？；、“”\"'<>（）()【】\\u4e00-\\u9fa5]+",
      "flags": "gi"
    },
    "urlBare": {
      "source": "(?<![@\\w.*-])(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+(?:com|cn|net|org|top|xyz|vip|cc|app|io|me|shop|site|online|club|info|link|live|pro|biz|tk|icu|work|fun|asia|hk|tw|example)(?:\\/[^\\s，。！？；、“”\"'<>（）()【】\\u4e00-\\u9fa5]*)?(?![\\w-])",
      "flags": "gi"
    },
    "email": {
      "source": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "flags": "g"
    },
    "eth": {
      "source": "(?<![0-9A-Za-z])0x[a-fA-F0-9]{40}(?![0-9A-Za-z])",
      "flags": "g"
    },
    "tron": {
      "source": "(?<![0-9A-Za-z])T[1-9A-HJ-NP-Za-km-z]{33}(?![0-9A-Za-z])",
      "flags": "g"
    },
    "btc": {
      "source": "(?<![0-9A-Za-z])(?:bc1[ac-hj-np-z02-9]{11,71}|[13][a-km-zA-HJ-NP-Z1-9]{25,34})(?![0-9A-Za-z])",
      "flags": "g"
    },
    "idCard": {
      "source": "(?<!\\d)[1-9]\\d{5}(?:19|20)\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx](?![\\dA-Za-z])",
      "flags": "g"
    },
    "bankCard": {
      "source": "(?<![\\dA-Za-z])\\d{4}(?:[ -]?\\d{4}){3}(?:[ -]?\\d{1,3})?(?![\\dA-Za-z])",
      "flags": "g"
    },
    "alipay": {
      "source": "(?:支付宝|支付寶|吱付宝|zfb|ZFB|Zfb|阿里支付)(?:账号|账户|号)?\\s*(?:是|为|叫)?\\s*[:：]?\\s*([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}|(?:\\+?86)?1[3-9]\\d{9})(?!\\d)",
      "flags": "g"
    },
    "qq": {
      "source": "(?:QQ|qq|Qq|qQ|扣扣|抠抠|口口|球球|企鹅|Q扣|q扣|扣Q|扣q|Q号|q号)(?:号|群)?(?:码)?\\s*(?:是|为|叫)?\\s*[:：]?\\s*([1-9]\\d{4,11})(?!\\d)",
      "flags": "g"
    },
    "wechat": {
      "source": "(?:微信|VX|vx|Vx|vX|V信|v信|wx|WX|Wx|薇信|威信|徽信|维信|微心|唯信|魏信|weixin|WeChat|wechat|加V|加v|\\+V|\\+v|➕V|➕v|绿泡泡|(?<![A-Za-z0-9])[Vv](?=\\s*[:：]))(?:号码|号)?\\s*(?:是|为|叫)?\\s*[:：]?\\s*([a-zA-Z][-_a-zA-Z0-9]{5,19})(?![-_a-zA-Z0-9])",
      "flags": "g"
    },
    "hotline": {
      "source": "(?<!\\d)(?:400|800)[\\s-]?\\d{3}[\\s-]?\\d{4}(?!\\d)",
      "flags": "g"
    },
    "landline": {
      "source": "(?<!\\d)0\\d{2,3}-\\d{7,8}(?!\\d)",
      "flags": "g"
    },
    "mobile": {
      "source": "(?<!\\d)(?:\\+?86[\\s-]?)?1[3-9]\\d[\\s.-]?\\d{4}[\\s.-]?\\d{4}(?!\\d)",
      "flags": "g"
    },
    "name": {
      "source": "(?:收款人姓名|收款人名字|收款姓名|开户人姓名|账户名字|账户姓名|户主姓名|户名|收款人|开户名|收款户名|账户名|持卡人|开户人)\\s*(?:写的是|填的是|是|为|叫|写|填)?\\s*[:：]?\\s*([\\u4e00-\\u9fa5](?:[\\u4e00-\\u9fa5]|[0-9](?![0-9])){1,3})",
      "flags": "g"
    },
    "amount": {
      "source": "(\\d+(?:\\.\\d+)?)\\s*(万元|万|元|块钱|块|USDT|U(?![A-Za-z])|美元)",
      "flags": "g"
    },
    "appQuoted": {
      "source": "[“\"「『]([\\u4e00-\\u9fa5A-Za-z0-9]{2,12})[”\"」』]\\s*(?:APP|app|App|软件|客户端|平台)",
      "flags": "g"
    },
    "appName": {
      "source": "(?:下载|安装|打开)(?:一个|一下|个)?[“\"「『]?([\\u4e00-\\u9fa5A-Za-z0-9]{2,12}?)[”\"」』]?(?:APP|app|App|软件|客户端)",
      "flags": "g"
    }
  },
