      "credit_threat": "征信恐吓",
      "cashout": "收款"
    },
    "campus": {
      "hook": "开场",
      "app": "下载与填资料",
      "obstacle": "制造放款障碍",
      "credit_threat": "征信恐吓",
      "cashout": "收款"
    }
  },
  "scenarios": {
    "refund": {
      "title": "冒充客服退款",
      "steps": [
        {
          "stage": "hook",
          "goal": "报身份取得信任",
          "lines": [
            "您好，我是{机构}的售后客服，工号{工号}，您前几天买的那件衣服我们这边查到有质量问题。",
            "不好意思打扰您，是这样的，您那笔购物记录我这边能看到，需要跟您核对一下收货信息。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "problem",
          "goal": "制造问题，抛出退款或赔付由头",
          "lines": [
            "这批货检测不合格，按规定要给您{金额}的赔付，不用退货。",
            "您不处理的话，系统会默认您放弃赔付，后面还可能每个月自动扣费。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "tool",
          "goal": "引导下载会议软件、共享屏幕",
          "lines": [
            "赔付要走专门通道，您下载一个{APP名}，输入我发的会议号，我一步步带您弄。",
            "您把屏幕共享打开，我这边看着您操作，免得点错。"
          ],
          "source": "TeleAntiFraud 数据集改写"
        },
        {
          "stage": "harvest",
          "goal": "套取验证码与账户信息",
          "lines": [
            "系统给您发了一条验证短信，您念一下数字，我这边帮您提交。",
            "赔付要打到您的卡上，您先报一下卡号和余额，我核对能不能到账。"
          ],
          "source": "TeleAntiFraud 数据集改写"
        },
        {
          "stage": "cashout",
          "goal": "引导转账或贷款转出",
          "lines": [
            "系统显示您的信用分不够，要先在借款页面开一下额度，再转到{银行卡}做个验证，验证完原路退回。",
            "刚才那笔没过，您再转{金额}到这个账户，户名{户名}，到了马上一起退。"
          ],
          "source": "反诈中心通报改写"
        }
      ]
    },
    "police": {
      "title": "冒充公检法 · 安全账户",
      "steps": [
        {
          "stage": "hook",
          "goal": "以业务人员身份开场，抛出“信息被冒用”",
          "lines": [
            "您好，这里是{机构}，您名下有一张卡被异地开户，涉及一起案子。",
            "您的医保卡在外地有异常消费，我们这边要给您转到警方处理。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "transfer_call",
          "goal": "转接“警方”，加强权威感",
          "lines": [
            "我是{机构}的民警，警号{工号}，你的案子我们已经立案了。",
            "我现在把电话转给负责的警官，你配合他做笔录。"
          ],
          "source": "裁判文书改写"
        },
        {
          "stage": "fear",
          "goal": "制造恐惧，抬出法律后果",
          "lines": [
            "你的卡涉嫌洗钱，再不配合调查就要冻结你名下全部资产。",
            "逮捕令已经下来了，你想自证清白，就照我说的做。"
          ],
          "source": "裁判文书改写"
        },
        {
          "stage": "isolate",
          "goal": "要求保密，隔离受害人",
          "lines": [
            "这个案子是保密的，不能告诉家人，也不能去银行问，否则按泄露案情处理。",
            "你现在找个没人的房间，电话不要挂，有人问就说在跟朋友聊天。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "cashout",
          "goal": "以“资金清查”为名要求转账",
          "lines": [
            "你把卡里的钱都转到国家安全账户{银行卡}，户名{户名}，清查完就退回给你。",
            "转之前把账户截图发到这个号{手机号}，我们登记备案。"
          ],
          "source": "裁判文书改写"
        }
      ]
    },
    "boss": {
      "title": "冒充领导熟人",
      "steps": [
        {
          "stage": "hook",
          "goal": "换号接触，冒充领导或熟人",
          "lines": [
            "小王，我是你们{机构}的老板，这是我新加的号，旧号不用了。",
            "是我啊，你听不出来了？我换了个手机号，记一下{手机号}。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "rapport",
          "goal": "寒暄铺垫，阻止电话核实",
          "lines": [
            "我这边在开会，不方便接电话，有事咱们就在这上面说。",
            "最近工作怎么样？你做事我一直放心，有个事想交给你办。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "request",
          "goal": "提出转账请求并制造紧迫",
          "lines": [
            "有个合作方的款今天必须付，我手上不方便，你先帮我垫{金额}，明天报销。",
            "这事别在群里说，也别问财务，抓紧办，办完跟我说一声。"
          ],
          "source": "裁判文书改写"
        },
        {
          "stage": "payout",
          "goal": "给出收款账户，催促到账",
          "lines": [
            "钱转到这个账户，{银行卡}，户名{户名}，转完把回单发我。",
            "刚才那笔对方说没收到，你再转一笔，别耽误了合同。"
          ],
          "source": "反诈中心通报改写"
        }
      ]
    },
    "pig": {
      "title": "杀猪盘 · 投资/感情",
      "steps": [
        {
          "stage": "contact",
          "goal": "搭讪并展示人设",
          "lines": [
            "不好意思加错人了，不过看你朋友圈挺有品味的，交个朋友吧。",
            "我在外地做生意，平时比较忙，难得遇到聊得来的人。"
          ],
          "source": "裁判文书改写"
        },
        {
          "stage": "grooming",
          "goal": "培养感情，拉近关系",
          "lines": [
            "今天降温了，你记得多穿点，别光顾着忙。",
            "跟你聊天特别放松，以后我们的事我都想跟你商量。"
          ],
          "source": "裁判文书改写"
        },
        {
          "stage": "pitch",
          "goal": "引入投资平台",
          "lines": [
            "我有个亲戚在{机构}内部，这个平台有漏洞期，跟着操作稳赚。",
            "你先在{网址}注册一个账号，我带你看一下我这几天的收益。"
          ],
          "source": "裁判文书改写"
        },
        {
          "stage": "small_win",
          "goal": "小额返利，让对方尝到甜头",
          "lines": [
            "你先充{金额}试试，赚了马上就能提出来。",
            "你看，提现已经到账了吧，我没骗你。"
          ],
          "source": "TeleAntiFraud 数据集改写"
        },
        {
          "stage": "escalate",
          "goal": "加码充值并阻止提现",
          "lines": [
            "这次行情难得，你多投一点，错过就没有了。",
            "账户显示要交一笔保证金才能解冻提现，你转到{银行卡}，交完就能全部取出来。"
          ],
          "source": "裁判文书改写"
        }
      ]
    },
    "task": {
      "title": "刷单返利 · 做任务赚佣金",
      "steps": [
        {
          "stage": "recruit",
          "goal": "以兼职招募为由开场",
          "lines": [
            "在家也能做的兼职，动动手指点赞关注，一单返几块钱，日结。",
            "我们在招线上推广员，不收任何费用，时间自由。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "onboard",
          "goal": "拉群并引导下载",
          "lines": [
            "你先加一下接待老师的微信{微信号}，他拉你进任务群。",
            "任务都在{APP名}里派，下载注册后找客服领新手任务。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "small_rebate",
          "goal": "小额返利取得信任",
          "lines": [
            "前三单是福利单，做完佣金马上返到你账上。",
            "你看佣金已经到了，做得越多返得越多。"
          ],
          "source": "TeleAntiFraud 数据集改写"
        },
        {
          "stage": "advance",
          "goal": "诱导垫付任务",
          "lines": [
            "接下来是连单任务，需要先垫付{金额}，做完连本带佣金一起返。",
            "这单是高佣金单，名额有限，垫得越多返得越多。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "lock_in",
          "goal": "以“卡单”为由继续收钱",
          "lines": [
            "你操作超时了，系统判定违规，要再做一组才能把前面的钱提出来。",
            "现在退出的话前面的本金都提不了，你再转{金额}到{银行卡}就能解冻。"
          ],
          "source": "裁判文书改写"
        }
      ]
    },
    "loan": {
      "title": "虚假贷款 · 征信修复",
      "steps": [
        {
          "stage": "hook",
          "goal": "以低息贷款为由开场",
          "lines": [
            "您好，我们是{机构}的信贷顾问，您有一笔低息额度，可以当天到账。",
            "不看征信，不用抵押，填个资料就能放款。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "app",
          "goal": "引导下载并填写资料",
          "lines": [
            "您下载一下{APP名}，按提示填身份信息和收款卡号。",
            "资料提交后我这边给您加急审核。"
          ],
          "source": "TeleAntiFraud 数据集改写"
        },
        {
          "stage": "obstacle",
          "goal": "制造放款障碍",
          "lines": [
            "系统显示您银行卡号填错了，账户被冻结，要交{金额}解冻费才能放款。",
            "您的流水不够，需要先转一笔到公司账户刷流水，证明还款能力。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "credit_threat",
          "goal": "以征信受损施压",
          "lines": [
            "不处理的话会被记为恶意骗贷，直接上征信，以后买房贷款都受影响。",
            "今天之内不交，额度作废，还要按违约处理。"
          ],
          "source": "裁判文书改写"
        },
        {
          "stage": "cashout",
          "goal": "给出收款账户",
          "lines": [
            "钱转到这个对公账户，{银行卡}，户名{户名}，到账后连本金一起放款。",
            "转完把截图发给放款专员，他的电话是{手机号}。"
          ],
          "source": "反诈中心通报改写"
        }
      ]
    },
    "campus": {
      "title": "注销校园贷 · 清空网贷额度",
      "steps": [
        {
          "stage": "hook",
          "goal": "以“注销校园贷”为由开场",
          "lines": [
            "你好，这边是{机构}客服，你上学时开过校园贷账户，按国家要求现在要注销。",
            "不注销的话会影响你的征信，你配合一下，几分钟就好。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "app",
          "goal": "引导下载会议软件或贷款APP",
          "lines": [
            "你下载一个{APP名}，输入会议号，我带你一步步注销。",
            "你打开手机上的几个借款软件，看看都有多少额度。"
          ],
          "source": "TeleAntiFraud 数据集改写"
        },
        {
          "stage": "obstacle",
          "goal": "以“清空额度”为由制造障碍",
          "lines": [
            "这些额度要先借出来，转到核查账户清空，系统才能注销。",
            "你的账户还有关联额度没清掉，注销卡在最后一步了。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "credit_threat",
          "goal": "以征信受损施压",
          "lines": [
            "今天不处理完，征信上就会留下逾期记录，影响你以后工作。",
            "这是最后一次通知，错过要去线下办理，很麻烦。"
          ],
          "source": "反诈中心通报改写"
        },
        {
          "stage": "cashout",
          "goal": "给出核查账户",
          "lines": [
            "借出来的钱转到这个核查账户，{银行卡}，户名{户名}，核查完原路退回。",
            "有问题打我电话{手机号}，不要找其他人。"
          ],
          "source": "裁判文书改写"
        }
      ]
    }
  }
}
