{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepsuck.si/assets/core/scam_scripts.schema.json",
  "title": "DeepSuck 诈骗话术语料（deepsuck.core.scam-scripts/v1）",
  "type": "object",
  "required": ["schema", "version", "license", "licenseUrl", "attribution", "usage", "thirdPartyNotice", "phases", "sourceTypes", "placeholders", "sources", "types", "entries"],
  "properties": {
    "schema": { "const": "deepsuck.core.scam-scripts/v1" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "license": { "const": "CC-BY-4.0" },
    "licenseUrl": { "const": "https://creativecommons.org/licenses/by/4.0/legalcode" },
    "attribution": { "const": "DeepSuck (deepsuck.si)" },
    "comment": { "type": "string" },
    "usage": { "type": "string", "minLength": 1 },
    "thirdPartyNotice": { "type": "string", "minLength": 1 },
    "phases": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": { "type": "object", "required": ["id", "name", "desc"], "properties": {
        "id": { "enum": ["opening", "trust", "pressure", "request", "payout"] }, "name": { "type": "string" }, "desc": { "type": "string" } } }
    },
    "sourceTypes": {
      "type": "object",
      "required": ["court_case", "police_case", "police_bulletin", "dataset", "awareness"],
      "additionalProperties": { "type": "object", "required": ["label"], "properties": { "label": { "type": "string", "pattern": "^据.+改写$" }, "comment": { "type": "string" } } }
    },
    "docTypes": { "type": "object", "additionalProperties": { "type": "string" } },
    "placeholders": {
      "type": "object",
      "additionalProperties": { "type": "object", "required": ["intel", "example"], "properties": {
        "intel": { "type": ["string", "null"] }, "example": { "type": "string" } } }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "docType", "title", "publisher", "url", "license", "usage", "accessed"], "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "docType": { "enum": ["police_release", "official_handbook", "procuratorate", "court", "dataset", "project_corpus"] },
        "title": { "type": "string" }, "publisher": { "type": "string" }, "date": { "type": "string" },
        "url": { "type": "string", "pattern": "^https?://" },
        "altUrls": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
        "license": { "type": "string", "minLength": 1 }, "licenseUrl": { "type": "string" },
        "usage": { "type": "string", "minLength": 1 },
        "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } } }
    },
    "types": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": { "type": "object", "required": ["id", "name", "corpusFile", "scenario", "simScenarios", "summary", "keywords", "stages", "pressureTactics", "redFlags"], "properties": {
        "id": { "enum": ["impersonate_cs", "impersonate_police", "impersonate_boss", "pig_butchering", "task_rebate", "investment", "loan_credit"] },
        "name": { "type": "string" }, "aliases": { "type": "array", "items": { "type": "string" } },
        "corpusFile": { "type": "string", "pattern": "^corpus/scripts/[a-z_]+\\.yaml$" },
        "scenario": { "type": ["string", "null"] },
        "simScenarios": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "keywords": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "stages": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name"] } },
        "pressureTactics": { "type": "array", "items": { "type": "object", "required": ["id", "name"] } },
        "redFlags": { "type": "array", "items": { "type": "string" } } } }
    },
    "entries": {
      "type": "array", "minItems": 35,
      "items": {
        "type": "object",
        "required": ["id", "type", "phase", "stage", "text", "keywords", "pressure", "tactics", "intel", "sourceType", "sourceLabel", "sourceIds", "sourceUrls", "scenarios"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+-\\d{3}$" },
          "type": { "type": "string" },
          "phase": { "enum": ["opening", "trust", "pressure", "request", "payout"] },
          "stage": { "type": "string" },
          "text": { "type": "string", "minLength": 4, "maxLength": 120 },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "pressure": { "type": "array", "items": { "type": "string" } },
          "tactics": { "type": "array", "items": { "type": "string" } },
          "intel": { "type": "array", "items": { "type": "string" } },
          "sourceType": { "enum": ["court_case", "police_case", "police_bulletin", "dataset", "awareness"] },
          "sourceLabel": { "type": "string" },
          "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "sourceRef": { "type": "string", "minLength": 1 },
          "sourceUrls": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https?://" } },
          "scenarios": { "type": "array", "items": { "type": "string" } },
          "variant": { "type": "string" }
        },
        "if": { "properties": { "sourceType": { "const": "awareness" } } },
        "then": { "not": { "required": ["sourceRef"] } },
        "else": { "required": ["sourceRef"] }
      }
    }
  }
}
