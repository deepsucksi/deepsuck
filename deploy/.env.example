# DeepSuck 实时服务配置（deploy/.env；bootstrap.sh 会自动生成）。
# 切勿提交真实 Key：deploy/.env 已在 .gitignore 中。

# ---- 域名 / HTTPS（必填，没有默认值；换成你自己的）----
# 留空时 docker compose 会报错退出
LIVE_DOMAIN=
ACME_EMAIL=
# 主站（GitHub Pages）与语音页本身；/api/chat 与 /api/offer 只接受这些 Origin
ALLOWED_ORIGINS=https://deepsuck.si,https://www.deepsuck.si
VOICE_ALLOWED_ORIGINS=https://live.deepsuck.si,https://deepsuck.si

# ---- DashScope（阿里云百炼，北京地域 Key）----
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_MAX_TOKENS=120

# ---- 费用护栏：文字对话（Node 代理）----
# 每日预算（元），用完当天 429 → 前端回退规则引擎
CHAT_DAILY_BUDGET_CNY=2
# 每 IP 每分钟
RATE_LIMIT_PER_MIN=20
# 每 IP 每天
RATE_LIMIT_PER_DAY=300
# 全站每分钟
GLOBAL_RATE_PER_MIN=60
# 每局骗子最多发言轮数
CHAT_MAX_TURNS=40

# ---- 费用护栏：语音演示 ----
# 每日预算（元）；开局按"本局最坏花费"预占，保证不超
VOICE_DAILY_BUDGET_CNY=5
# 同时通话路数
VOICE_MAX_SESSIONS=2
# 每局最长分钟
VOICE_MAX_MINUTES=5
# 每局最多轮数
VOICE_MAX_TURNS=30
# 静默多久自动挂断（ASR 按音频时长计费，静默也花钱）
VOICE_IDLE_SECONDS=60
VOICE_PER_IP_PER_HOUR=4
VOICE_PER_IP_PER_DAY=10
# llm | rule（rule = 不调大模型，只花 ASR/TTS）
VOICE_ENGINE=llm

# ---- 单价（元；2026-10 百炼北京原价，以控制台为准）----
PRICE_LLM_IN_PER_M=0.8
PRICE_LLM_OUT_PER_M=2
PRICE_ASR_PER_SEC=0.00024
PRICE_TTS_PER_10K_CHARS=0.8

# ---- WebRTC 网络 ----
# 防火墙放行这一段 UDP；开自建 SIP（下方 SIP_*）时改成 40000-40099，后半段 40100-40199 给 SIP 的 RTP
VOICE_UDP_PORTS=40000-40199
# 服务器公网 IP（bootstrap 自动探测）；会作为候选写进 SDP 应答
VOICE_PUBLIC_IP=
# 服务器内网 IP（仅 coturn 用）
PRIVATE_IP=
# 服务端 STUN：只在拿不到公网 IP 时才需要（例：stun:stun.l.google.com:19302）。
# 注意 STUN 不通时每次接通会多等 ~5 秒，所以设置了 VOICE_PUBLIC_IP 就留空。
VOICE_SERVER_STUN=
VOICE_BROWSER_STUN=
VOICE_CONNECT_TIMEOUT=30
VOICE_MEM_LIMIT=700m

# ---- 可选 TURN（docker compose --profile turn up -d）----
TURN_SECRET=
TURN_URLS=
# TURN_URLS=turn:live.deepsuck.si:3478?transport=udp,turn:live.deepsuck.si:3478?transport=tcp

# ---- 电话入口（docs/PHONE.md 第 6 节；默认全部关闭）----
# 1 才挂载 WS /telephony/{adapter}
VOICE_TELEPHONY=0
# 必填（开电话时）：为空时即使 VOICE_TELEPHONY=1 也拒绝连接；生成：openssl rand -hex 24
VOICE_TELEPHONY_TOKEN=
# 允许的适配器，逗号分隔：ws-raw、pipecat-ws、asterisk-ws（自建 SIP 软电话用）
VOICE_TELEPHONY_ADAPTERS=ws-raw
VOICE_TELEPHONY_PERSONA=wang
VOICE_TELEPHONY_SCENARIO=refund
# 仅 pipecat-ws + 对应运营商时需要（用于 REST 挂断）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELNYX_API_KEY=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# ---- 自建 SIP 软电话（docker compose --profile sip up -d；docs/PHONE.md 第 10 节；默认不启动）----
# 只让自己手机上的 Linphone/Zoiper 注册后拨 SIP_AI_EXTEN 跟 AI 对话；没有外线、没有外呼，不是真实号码。
# 开启前提：VOICE_TELEPHONY=1、VOICE_TELEPHONY_TOKEN 已设、VOICE_TELEPHONY_ADAPTERS 含 asterisk-ws，
# VOICE_UDP_PORTS=40000-40099。bootstrap.sh 用 WITH_SIP=1 会自动填好下面的账号密码并装 fail2ban。
# 分机账号（3-32 位字母/数字/_.-；建议不好猜，例如 openssl rand -hex 4）
SIP_USER=
# 必填，至少 16 位，只能含字母/数字/._~+=-（openssl rand -hex 16）；为空时 sip 容器拒绝启动
SIP_PASSWORD=
# SIP 信令端口（UDP；SIP_TCP=1 时同端口再开 TCP）；不要用 5060
SIP_PORT=25060
SIP_TCP=0
# 唯一能接通 AI 的分机号（3-8 位数字），拨其他号码一律 404
SIP_AI_EXTEN=9000
# Asterisk 的 RTP 端口段（与 VOICE_UDP_PORTS 不重叠）
SIP_RTP_PORTS=40100-40199
# 同时通话数（1-9）；voice 侧仍受 VOICE_MAX_SESSIONS、每日预算等护栏约束
SIP_MAX_CALLS=1
# 手机侧允许的编码，按优先级
SIP_CODECS=opus,g722,ulaw,alaw
# 可选：只允许这些来源 IP 注册/呼叫（逗号分隔 IPv4 CIDR）；留空不限制，靠密码 + fail2ban
SIP_ALLOW_CIDR=
# 可选：SDP 里写的公网 IP；留空用 VOICE_PUBLIC_IP
SIP_PUBLIC_IP=
# Asterisk security 日志在宿主机上的目录（fail2ban 读取）
SIP_LOG_DIR=/var/log/deepsuck-sip
SIP_MEM_LIMIT=64m

# ---- 告知语（网页和电话共用；默认不播）----
VOICE_AI_DISCLOSURE=0
# 自定义告知语，仅在 VOICE_AI_DISCLOSURE=1 时生效；留空用默认文案
VOICE_AI_DISCLOSURE_TEXT=

# ---- 留存 ----
# 容器内固定 DATA_DIR=/data（命名卷 voice-data），这里不用设置
# 每通结束保存一份脱敏文字记录；0 关闭
VOICE_TRANSCRIPTS=1
# 文字记录保留天数；0 表示不自动删除
VOICE_TRANSCRIPT_DAYS=30
# 1 才保存原始音频（对方、机器人各一个 WAV）
KEEP_AUDIO=0
# 音频保留天数，1 至 7
KEEP_AUDIO_DAYS=7
