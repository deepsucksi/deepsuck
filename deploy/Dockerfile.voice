# DeepSuck 语音演示（voice/，Pipecat + SmallWebRTC + DashScope）。
# 构建上下文：仓库根目录。只装运行时依赖（不含 pytest/httpx）。
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    XDG_CACHE_HOME=/cache DATA_DIR=/data VOICE_HOST=127.0.0.1 VOICE_PORT=7860 TRUST_PROXY=1 \
    OMP_NUM_THREADS=1 MALLOC_ARENA_MAX=2 LOGURU_LEVEL=INFO \
    VOICE_DAILY_BUDGET_CNY=5 VOICE_UDP_PORTS=40000-40199 VOICE_ALLOWED_ORIGINS=https://live.deepsuck.si,https://deepsuck.si
WORKDIR /app
COPY voice/requirements.txt voice/requirements.txt
RUN grep -vE '^(pytest|httpx)\b' voice/requirements.txt > /tmp/req.txt && pip install -r /tmp/req.txt && \
    find /usr/local/lib/python3.12 -name '__pycache__' -prune -exec rm -rf {} + || true
COPY python/ python/
COPY voice/ voice/
# 人设唯一数据源（含口头语 voiceTraits、建议底噪 ambience；voice/persona.py、voice/ambience.py 运行时读取）
COPY site/assets/core/ site/assets/core/
COPY site/assets/logo.svg site/assets/logo.svg
COPY site/assets/brand/wordmark.svg site/assets/brand/on-hold-mono-96.png site/assets/brand/
# 人设头像（与首页同一组 round6 照片，见 personas.json 的 photo）
COPY site/assets/brand/round6/*-400.webp site/assets/brand/round6/
COPY site/assets/fonts/Manrope.ttf site/assets/fonts/IBMPlexMono-Regular.ttf site/assets/fonts/
RUN useradd -r -u 1000 app && mkdir -p /data /cache /traces && chown app:app /data /cache /traces && chmod 700 /traces
# 代码版本（写进通话追踪）：构建参数 GIT_SHA 优先；没传时用 .dockerignore 放行的 .git/HEAD 与 refs（不含对象库）
ARG GIT_SHA=
ENV GIT_SHA=${GIT_SHA}
COPY .git/HEA[D] .git/packed-ref[s] /app/.gitmeta/
COPY .git/refs/head[s] /app/.gitmeta/refs/heads/
USER app
CMD ["python", "-m", "voice.app"]
