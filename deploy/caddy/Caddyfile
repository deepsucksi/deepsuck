# DeepSuck 实时服务反向代理（自动 HTTPS，Let's Encrypt / ZeroSSL）。
# 静态站仍在 GitHub Pages（deepsuck.si）；这里只服务 {$LIVE_DOMAIN}：
# LIVE_DOMAIN、ACME_EMAIL 没有默认值，由 docker-compose.yml 的 ${VAR:?} 强制要求设置。
#   /api/chat、/api/health → Node 大模型代理（127.0.0.1:8787）
#   其余（语音演示页面、/api/config、/api/offer）→ 语音服务（127.0.0.1:7860）
{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_body 15s
			idle 2m
		}
	}
}

{$LIVE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "microphone=(self), camera=()"
		-Server
	}
	handle /api/chat {
		reverse_proxy 127.0.0.1:8787
	}
	handle /api/health {
		reverse_proxy 127.0.0.1:8787
	}
	# 自建 SIP 的 Asterisk 只从本机回环连 voice，这个入口不对公网开放
	handle /telephony/asterisk-ws* {
		respond 404
	}
	# 通话追踪读取端只给服务器本机用（127.0.0.1:7860 + TRACE_ADMIN_TOKEN），公网一律 404
	handle /api/traces* {
		respond 404
	}
	# 其余（含 VOICE_TELEPHONY=1 时的 WS /telephony/*）都交给语音服务
	handle {
		reverse_proxy 127.0.0.1:7860
	}
	log {
		output stdout
		format console
	}
}
