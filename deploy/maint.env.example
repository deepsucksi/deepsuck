# /etc/default/deepsuck-maint：deepsuck-{diskwatch,docker-prune,cost}.service 的配置（install-timers.sh 首次安装时复制，之后不覆盖）。
# 全部可省略，省略即用注释里的默认值。改完不用 daemon-reload，下次触发生效。
# 磁盘告警阈值（%，严格大于才告警）
#DISKWATCH_WARN_PCT=80
#DISKWATCH_CRIT_PCT=90
# 检查哪些目录所在分区（同一分区只报一次）
#DISKWATCH_PATHS="/ /var/lib/docker /var/lib/containerd"
# trace 卷告警的基准（缺省读 deploy/.env，与容器一致）。diskwatch 不删通话数据，保留天数由容器的 TRACE_DAYS / TRACE_AUDIO_DAYS 管
#TRACE_MAX_MB=1024
# docker 清理前必须存在的回滚镜像（空格分隔），缺任何一个就跳过清理并记 ERROR
ROLLBACK_TAGS="deepsuck-caddy:rollback-887ac0"
# 成本汇总输出目录、保留天数、评测花费 CSV、优惠券基准（默认在 voice-data 卷根目录）
#COST_OUT_DIR=/var/log/deepsuck
#COST_KEEP_DAYS=180
#COST_EVAL_SPEND=/var/lib/deepsuck/eval-spend.csv
#COST_BASELINE=/var/lib/docker/volumes/deepsuck_voice-data/_data/cost-baseline.json
# 每日重跑 trace 脱敏（deepsuck-redact.service，#107）在哪个容器里执行
#REDACT_CONTAINER=deepsuck-voice-1
#REDACT_BACKUP=1                       # 0 = 回填不留备份（#254 默认留 24 小时）
#REDACT_BACKUP_DIR=/traces/backups     # 容器内路径（voice-traces 卷）
#REDACT_BACKUP_KEEP_HOURS=24
